{
  "name": "cutx",
  "productName": "CUTX",
  "version": "0.1.0-beta.1",
  "description": "Live coding musicale come un CDJ, basato su Strudel",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "prova": "vite build && electron . --prova",
    "test": "node --test test/*.test.js",
    "schermate": "vite build && electron . --schermate=schermate",
    "test:app": "vite build && node --test test/app/*.test.js"
  },
  "dependencies": {
    "@strudel/codemirror": "1.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "vite": "^6.4.4"
  }
}
